<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://tiago.dev/kick-native-diagnostic" version="1.0.0" viewmodes="fullscreen">
    <access origin="https://kick.com" subdomains="true"></access>
    <access origin="https://playback.live-video.net" subdomains="true"></access>
    <tizen:application id="tiagokick3.NativeDiag" package="tiagokick3" required_version="2.3"/>
    <content src="index.html"/>
    <description>Local diagnostic for native Kick HLS playback</description>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>Kick Native Diagnostic</name>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="enable" install-location="auto" hwkey-event="enable"/>
</widget>
